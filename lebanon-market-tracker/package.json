{
  "name": "lebanon-market-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Lebanon Market Tracker — منصة استخبارات الأسواق اللبنانية",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "LMT_LIVE_SMOKE=1 vitest run tests/smoke",
    "db:local": "bash scripts/local-postgres.sh",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed:demo": "tsx --conditions=react-server scripts/seed-demo.ts",
    "ingest": "tsx --conditions=react-server scripts/ingest.ts",
    "connector:test": "tsx --conditions=react-server scripts/ingest.ts --test",
    "worker": "tsx --conditions=react-server scripts/worker.ts",
    "analytics": "bash scripts/analytics.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.55.0",
    "next": "^15.5.27",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
