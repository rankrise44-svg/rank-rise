# ─────────────────────────────────────────────────────────────────────────────
# Lebanon Market Tracker — environment variables
# Copy to .env.local and fill in. NEVER commit real values. All variables are
# read on the server only; none are exposed to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection (required). `npm run db:local` starts a local cluster on port 5433.
DATABASE_URL=postgres://lmt@127.0.0.1:5433/lmt
# Separate database for automated tests (never point this at real data).
DATABASE_URL_TEST=postgres://lmt@127.0.0.1:5433/lmt_test
# Set to true for managed databases that require TLS (e.g. Supabase, Neon).
DATABASE_SSL=false

# Authentication (required in production). Single owner account.
# SESSION_SECRET: ≥ 32 random characters, e.g. `openssl rand -hex 32`.
SESSION_SECRET=replace-with-64-hex-characters-from-openssl-rand-hex-32
# ADMIN_PASSWORD: ≥ 10 characters. Used on the /login page.
ADMIN_PASSWORD=replace-with-a-long-password
# Require login for viewing pages too (recommended: true).
REQUIRE_LOGIN=true

# Encryption key for API credentials stored in the database (AES-256-GCM).
# 32 bytes, base64: `openssl rand -base64 32`. Changing it makes stored keys unreadable.
SECRETS_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32

# Shared secret for the scheduler endpoint GET /api/cron (Authorization: Bearer …). ≥ 16 chars.
CRON_SECRET=replace-with-random-string

# Display timezone (IANA). Can also be changed in Settings.
DEFAULT_TIMEZONE=Asia/Beirut
# Days to keep raw API payloads for audit/re-parsing (0 disables storage).
RAW_PAYLOAD_RETENTION_DAYS=30
# Development only: allow synthetic demo data to be shown (forbidden in production).
DEMO_MODE=false

# ── Conversational AI (optional). Without it, the assistant runs in retrieval-only mode. ──
# none | anthropic | openai_compatible
LLM_PROVIDER=none
# anthropic: e.g. claude-opus-5-5   ·   openai_compatible: the model name your server exposes (e.g. qwen2.5:14b)
LLM_MODEL=
# anthropic: your Anthropic API key   ·   openai_compatible: optional bearer token
LLM_API_KEY=
# openai_compatible: base URL of an OpenAI-style API, e.g. http://localhost:11434/v1 (Ollama)
LLM_BASE_URL=
# Maximum tool-calling rounds per question (1–8).
LLM_MAX_TOOL_ROUNDS=5

# ── Optional market-data providers (can also be entered, encrypted, in Sources & data) ──
TWELVEDATA_API_KEY=
ALPHAVANTAGE_API_KEY=

# Minimum spacing between GDELT requests in ms (GDELT asks for ≥ 5000).
GDELT_MIN_INTERVAL_MS=6000
# Background worker cadence (scripts/worker.ts).
WORKER_INTERVAL_MINUTES=5
