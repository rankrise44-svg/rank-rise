diff --git a/docs/bios/redesign/css/command.css b/docs/bios/redesign/css/command.css
new file mode 100644
index 0000000..36217c1
--- /dev/null
+++ b/docs/bios/redesign/css/command.css
@@ -0,0 +1,630 @@
+@charset "UTF-8";
+/* =====================================================================
+   BIOS Command Center — visual layer (loaded last).
+   Step 1: ground, type, shell (sidebar, top bar, sample bar), buttons,
+   theme toggle and the shared motion primitives. Only styling here.
+   ===================================================================== */
+
+/* ---------- ground: deep indigo with a slow aurora ---------- */
+html{background:var(--bg)}
+body{background:var(--bg);font-family:var(--sans);font-feature-settings:"ss01";letter-spacing:.005em}
+body::before{content:"";position:fixed;inset:-25%;z-index:0;pointer-events:none;
+  background:
+    radial-gradient(40% 35% at 18% 12%, var(--aurora-1), transparent 70%),
+    radial-gradient(35% 30% at 85% 20%, var(--aurora-2), transparent 70%),
+    radial-gradient(45% 40% at 70% 95%, var(--aurora-3), transparent 70%),
+    linear-gradient(180deg, var(--bg-2), var(--bg) 60%);
+  animation:aurora 38s ease-in-out infinite alternate}
+@keyframes aurora{50%{transform:translate3d(2%,-3%,0) rotate(2deg)}100%{transform:translate3d(-2%,2%,0) rotate(-1deg)}}
+#root{position:relative;z-index:1}
+
+/* ---------- type ---------- */
+h1,h2,h3,h4{font-family:var(--head);letter-spacing:.01em}
+.pagehead h1{font-size:var(--t-2xl);font-weight:600;line-height:1.1}
+.label,.eyebrow,.crumb,.sectitle h2,.panel > header h3{font-family:var(--head);letter-spacing:.14em}
+.eyebrow{background:var(--grad-brand);-webkit-background-clip:text;background-clip:text;color:transparent}
+
+/* ---------- sidebar ---------- */
+.side{background:linear-gradient(180deg,color-mix(in srgb,var(--solid) 78%,transparent),color-mix(in srgb,var(--bg) 70%,transparent));
+  backdrop-filter:blur(var(--blur)) saturate(140%);-webkit-backdrop-filter:blur(var(--blur)) saturate(140%);
+  border-right:1px solid var(--glass-border);box-shadow:inset -1px 0 0 var(--glass-hi)}
+.side .brand{align-items:center;gap:10px;padding:18px 16px 14px}
+.side .brand::before{content:"";width:30px;height:30px;border-radius:9px;flex:none;background:var(--grad-brand);
+  box-shadow:var(--glow-brand), inset 0 1px 0 rgba(255,255,255,.35);
+  -webkit-mask:radial-gradient(circle at 50% 50%, transparent 5px, #000 5.5px);mask:radial-gradient(circle at 50% 50%, transparent 5px, #000 5.5px)}
+.side .brand b{font-size:22px;background:linear-gradient(90deg,var(--ink),color-mix(in srgb,var(--ink) 60%,var(--accent)));-webkit-background-clip:text;background-clip:text;color:transparent}
+.side .brand span{font-family:var(--head);letter-spacing:.2em}
+
+.wsbtn{background:var(--raised);border:1px solid var(--glass-border);border-radius:var(--r);box-shadow:var(--shadow);
+  transition:transform var(--d-mid) var(--ease-spring),box-shadow var(--d-mid),border-color var(--d-mid)}
+.wsbtn:hover{transform:translateY(-1px) scale(var(--zoom-card));border-color:var(--accent-line);box-shadow:var(--glow-brand)}
+.wsdot{background:var(--grad-brand);box-shadow:var(--glow-brand);border-radius:9px;color:#fff}
+
+.navsec > button.sechead{font-family:var(--head);font-size:10.5px;letter-spacing:.2em;padding:10px 10px 6px}
+.navitem{position:relative;overflow:hidden;border-radius:10px;padding:7px 10px;font-weight:500;
+  transition:transform var(--d-mid) var(--ease-spring),background var(--d-mid),color var(--d-mid),box-shadow var(--d-mid);
+  transform-origin:left center}
+.navitem:hover{background:color-mix(in srgb,var(--ink) 5%,transparent);color:var(--ink);transform:scale(var(--zoom-text))}
+.navitem:active{transform:scale(var(--press))}
+.navitem[aria-current="page"]{color:var(--ink);font-weight:600;
+  background:linear-gradient(90deg,color-mix(in srgb,#7B5CFF 30%,transparent),color-mix(in srgb,#3D7BFF 8%,transparent));
+  box-shadow:inset 0 0 0 1px var(--accent-line)}
+.navitem[aria-current="page"]::before{content:"";position:absolute;left:0;top:18%;bottom:18%;width:3px;border-radius:0 3px 3px 0;background:var(--grad-brand);box-shadow:0 0 12px #7B5CFF}
+.navitem.top .gl{width:24px;height:24px;border-radius:8px;color:#fff;font-size:12px;background:var(--grad-brand);box-shadow:inset 0 1px 0 rgba(255,255,255,.3)}
+.navsec:first-child .navitem:nth-child(2) .gl{background:var(--grad-info)}
+.navsec:first-child .navitem:nth-child(3) .gl{background:var(--grad-live)}
+.navsec:first-child .navitem:nth-child(4) .gl{background:var(--grad-warn)}
+.navsec:last-child .navitem .gl{background:var(--grad-unknown)}
+.navitem[aria-current="page"] .gl{color:#fff;box-shadow:0 0 14px color-mix(in srgb,#7B5CFF 70%,transparent)}
+.navitem .badge{font-family:var(--head);font-weight:600;font-size:10.5px}
+.badge.hot{background:var(--grad-hot);color:#fff;box-shadow:var(--glow-hot);animation:hot-pulse 2.4s ease-in-out infinite}
+.badge.acc{background:var(--grad-brand);color:#fff}
+@keyframes hot-pulse{50%{box-shadow:0 0 0 3px color-mix(in srgb,#FF3B3B 18%,transparent),0 6px 20px -4px #FF3B3B}}
+
+.brainmeter{margin:8px 10px 12px;border:1px solid var(--glass-border);border-radius:var(--r);background:var(--raised);box-shadow:var(--shadow)}
+.brainmeter .num{font-family:var(--sans);font-weight:800;font-size:14px;font-variant-numeric:tabular-nums}
+.brainmeter .meter{height:7px;background:var(--sunken)}
+.brainmeter .meter i{background:var(--grad-brand);box-shadow:0 0 12px -2px #7B5CFF}
+.brainmeter .meter i.ok{background:var(--grad-live)} .brainmeter .meter i.warn{background:var(--grad-warn)} .brainmeter .meter i.bad{background:var(--grad-hot)}
+
+/* ---------- top bar ---------- */
+.topbar{background:color-mix(in srgb,var(--bg) 62%,transparent);backdrop-filter:blur(var(--blur)) saturate(140%);-webkit-backdrop-filter:blur(var(--blur)) saturate(140%);
+  border-bottom:1px solid var(--glass-border)}
+.cmd{background:var(--surface);border:1px solid var(--glass-border);border-radius:14px;box-shadow:var(--shadow);
+  transition:box-shadow var(--d-mid),border-color var(--d-mid),transform var(--d-mid) var(--ease-spring)}
+.cmd:focus-within{border-color:var(--accent-line);box-shadow:var(--glow-brand);transform:translateY(-1px)}
+.cmd .ctx{background:linear-gradient(135deg,color-mix(in srgb,#7B5CFF 22%,transparent),color-mix(in srgb,#3D7BFF 14%,transparent));border-color:var(--accent-line);color:var(--ink)}
+.cmd .kbd{border-color:var(--glass-border);background:var(--sunken)}
+.cmd input::placeholder{color:var(--muted)}
+/* the "Live engine ready" chip becomes a pulsing LIVE badge; the off state stays quiet */
+.topbar .right .chip.ok{background:var(--grad-live);color:#062A22;border:0;font-weight:600;box-shadow:var(--glow-live);animation:live-glow 2.2s ease-in-out infinite}
+.topbar .right .chip.ok::before{background:#062A22;animation:pulse 1.2s ease-in-out infinite}
+@keyframes live-glow{50%{box-shadow:0 0 0 4px color-mix(in srgb,#2EE6A8 16%,transparent),0 8px 28px -4px #19D3C5}}
+.topbar .right .chip.dim{background:var(--sunken);border-color:var(--glass-border)}
+.seg{background:var(--sunken);border-color:var(--glass-border)}
+.seg button{position:relative;overflow:hidden;transition:transform var(--d-mid) var(--ease-spring),color var(--d-mid),background var(--d-mid)}
+.seg button:hover{transform:scale(var(--zoom-text));color:var(--ink)}
+.seg button[aria-selected="true"],.seg button[aria-pressed="true"]{background:var(--grad-brand);color:#fff;box-shadow:var(--glow-brand)}
+.iconbtn{position:relative;overflow:hidden;border-radius:12px;transition:transform var(--d-slow) var(--ease-spring),background var(--d-mid),color var(--d-mid)}
+.topbar .iconbtn[data-act="theme"]{width:36px;height:36px;border:1px solid var(--glass-border);background:var(--surface);box-shadow:var(--shadow);font-size:16px}
+.topbar .iconbtn[data-act="theme"]:hover{transform:rotate(180deg) scale(1.08);color:var(--ink);box-shadow:var(--glow-brand)}
+
+/* ---------- sample bar ---------- */
+.samplebar{background:linear-gradient(90deg,color-mix(in srgb,#FFB547 15%,transparent),color-mix(in srgb,#FF7A3D 6%,transparent) 70%,transparent);
+  border-bottom:1px solid color-mix(in srgb,var(--warn) 26%,transparent);backdrop-filter:blur(8px)}
+.samplebar b{background:var(--grad-warn);-webkit-background-clip:text;background-clip:text;color:transparent;font-family:var(--head);letter-spacing:.04em;font-size:13px}
+.samplebar .linkbtn{transition:transform var(--d-mid) var(--ease-spring)}
+.samplebar .linkbtn:hover{transform:scale(var(--zoom-text));text-decoration:none}
+
+/* ---------- buttons (shared) ---------- */
+.btn{position:relative;overflow:hidden;background:var(--grad-brand);border:0;border-radius:12px;font-weight:600;
+  box-shadow:0 1px 0 rgba(255,255,255,.25) inset,0 6px 18px -8px #5B6CFF;
+  transition:transform var(--d-mid) var(--ease-spring),box-shadow var(--d-mid),filter var(--d-mid)}
+.btn:hover{filter:none;transform:translateY(-1px) scale(var(--zoom-text));box-shadow:0 1px 0 rgba(255,255,255,.25) inset,var(--glow-brand)}
+.btn:active{transform:scale(var(--press))}
+.btn.ghost{background:var(--surface);border:1px solid var(--glass-border);color:var(--ink);box-shadow:var(--shadow)}
+.btn.ghost:hover{border-color:var(--accent-line);color:var(--ink);box-shadow:var(--glow-brand)}
+.btn.quiet{background:transparent;box-shadow:none}
+.btn.quiet:hover{background:color-mix(in srgb,var(--ink) 6%,transparent);box-shadow:none}
+.btn.danger{background:transparent;border:1px solid color-mix(in srgb,var(--bad) 45%,transparent);box-shadow:none}
+.btn.danger:hover{box-shadow:var(--glow-hot)}
+.btn:disabled,.btn[aria-disabled="true"]{transform:none;box-shadow:none}
+.linkbtn{transition:color var(--d-mid)}
+.choice{position:relative;overflow:hidden}
+
+/* ---------- overlays stay opaque enough to read (full polish in step 7) ---------- */
+.drawer,.modal{background:var(--solid)}
+@media (max-width:980px){ .side{background:var(--solid)} }
+
+/* ---------- motion primitives ---------- */
+.m-ripple{position:absolute;border-radius:50%;pointer-events:none;background:currentColor;opacity:.22;transform:scale(0);animation:ripple .6s var(--ease-out) forwards}
+@keyframes ripple{to{transform:scale(1);opacity:0}}
+.m-enter > *{animation:m-in .62s var(--ease-out) both;animation-delay:calc(var(--i,0) * 45ms)}
+@keyframes m-in{from{opacity:0;transform:translate3d(0,14px,0)}}
+::view-transition-old(root),::view-transition-new(root){animation-duration:.5s;animation-timing-function:var(--ease-out)}
+.theme-fading,.theme-fading *{transition:background-color .45s,color .45s,border-color .45s,fill .45s,stroke .45s !important}
+
+@media (prefers-reduced-motion:reduce){
+  body::before{animation:none}
+  .m-enter > *{animation:none}
+  .navitem:hover,.btn:hover,.seg button:hover,.wsbtn:hover,.topbar .iconbtn[data-act="theme"]:hover{transform:none}
+}
+/* light mode: gradient text is too pale on a bright ground, use the solid warning ink */
+:root[data-theme="light"] .samplebar b{background:none;color:var(--warn)}
+
+/* =====================================================================
+   Step 2 — shared components + Overview
+   ===================================================================== */
+
+/* ---------- numbers: Manrope bold, tabular ---------- */
+.num,.tile .v,.cibrainstats .n,.ringstat .v,.okv .v,table.t td.n,.decision .num,.goal .top .push{font-family:var(--sans);font-variant-numeric:tabular-nums;font-feature-settings:"tnum"}
+.tile .v{font-weight:800;font-size:28px;letter-spacing:-.02em}
+.ringstat .v{font-weight:800}
+
+/* ---------- glass cards ---------- */
+.panel,.tile,.decision,.insight,.alert,.card,.well,.empty{position:relative}
+.panel{background:var(--surface);border:1px solid var(--glass-border);border-radius:var(--r-lg);box-shadow:var(--shadow);
+  backdrop-filter:blur(14px) saturate(130%);-webkit-backdrop-filter:blur(14px) saturate(130%)}
+.panel > header{border-bottom-color:var(--line)}
+.panel > header h3{color:var(--ink-2);font-size:11.5px;font-weight:600}
+.panel.accent{border-color:var(--accent-line)}
+.panel.lift{box-shadow:var(--shadow-lift)}
+.panel.accent.lift{box-shadow:var(--glow-brand),var(--shadow-lift)}
+.well{background:var(--raised);border-color:var(--glass-border);border-radius:var(--r)}
+
+/* ---------- 3D tilt + cursor spotlight (motion.js sets --rx --ry --mx --my) ---------- */
+.m-tilt{transform:perspective(1000px) rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg)) translate3d(0,var(--lift,0px),0);
+  transition:transform .6s var(--ease-spring),box-shadow .3s,border-color .3s}
+.m-tilt.m-hot{--lift:-3px;transition:transform .14s ease-out,box-shadow .3s,border-color .3s;border-color:var(--accent-line);box-shadow:var(--shadow-lift),0 0 0 1px color-mix(in srgb,var(--accent) 22%,transparent)}
+.m-tilt::after{content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;opacity:0;transition:opacity .3s;
+  background:radial-gradient(320px circle at var(--mx,50%) var(--my,50%),color-mix(in srgb,var(--ink) 9%,transparent),transparent 62%)}
+.m-tilt.m-hot::after{opacity:1}
+
+/* ---------- stat tiles: glow blob by what the number means ---------- */
+.tile{background:var(--surface);border:1px solid var(--glass-border);border-radius:var(--r-lg);box-shadow:var(--shadow);overflow:hidden;padding:15px 16px;
+  backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px)}
+.tile::before{content:"";position:absolute;width:140px;height:140px;right:-46px;top:-56px;border-radius:50%;pointer-events:none;
+  background:var(--grad-brand);filter:blur(34px);opacity:.34;transition:opacity .3s,transform .6s var(--ease-out)}
+.tile:has(.d.up)::before{background:var(--grad-live)}
+.tile:has(.d.down)::before{background:var(--grad-hot)}
+.tile.na::before{background:var(--grad-unknown);opacity:.2}
+.tile.m-hot::before{opacity:.55;transform:scale(1.15)}
+.tile .l{font-family:var(--head);letter-spacing:.12em;font-size:11px;color:var(--ink-2)}
+.tile .v{transform-origin:left center;transition:transform var(--d-mid) var(--ease-spring)}
+.tile:hover .v{transform:scale(1.06)}
+.tile .d{font-family:var(--sans);font-weight:600;font-size:12px}
+.tile .spark{filter:drop-shadow(0 3px 8px color-mix(in srgb,var(--accent) 35%,transparent))}
+.tile .spark path:last-of-type{stroke-width:2}
+
+/* ---------- card titles zoom on hover ---------- */
+.panel > header h3,.insight .h,.decision .q,.goal .top .h,.list .li .main > b,.alert .t{display:inline-block;transform-origin:left center;transition:transform var(--d-mid) var(--ease-spring)}
+.panel:hover > header h3,.insight:hover .h,.decision:hover .q,.goal:hover .top .h,.list .li:hover .main > b,.alert:hover .t{transform:scale(var(--zoom-text))}
+
+/* ---------- chips, badges, status pills: soft gradient fills ---------- */
+.chip{border-radius:8px;border-color:var(--glass-border);background:var(--sunken);font-weight:500}
+.chip.ok{background:linear-gradient(135deg,color-mix(in srgb,#19D3C5 22%,transparent),color-mix(in srgb,#3BE08A 10%,transparent));border-color:color-mix(in srgb,var(--ok) 38%,transparent)}
+.chip.warn{background:linear-gradient(135deg,color-mix(in srgb,#FFB547 22%,transparent),color-mix(in srgb,#FF7A3D 10%,transparent));border-color:color-mix(in srgb,var(--warn) 38%,transparent)}
+.chip.bad{background:linear-gradient(135deg,color-mix(in srgb,#FF4D8D 22%,transparent),color-mix(in srgb,#FF3B3B 10%,transparent));border-color:color-mix(in srgb,var(--bad) 40%,transparent)}
+.chip.acc{background:linear-gradient(135deg,color-mix(in srgb,#7B5CFF 24%,transparent),color-mix(in srgb,#3D7BFF 12%,transparent));border-color:var(--accent-line)}
+.chip.info{background:linear-gradient(135deg,color-mix(in srgb,#35C8FF 22%,transparent),color-mix(in srgb,#4F6BFF 10%,transparent));border-color:color-mix(in srgb,var(--info) 38%,transparent)}
+.chip.dim{background:var(--sunken)}
+.st.pill{border-radius:8px}
+.badge{border-radius:10px}
+.conf i.on{background:var(--grad-brand)} .sev i.on{background:var(--grad-hot)}
+
+/* ---------- meters: gradient fills with a soft glow ---------- */
+.meter{background:var(--sunken);height:7px}
+.meter i{background:var(--grad-brand);box-shadow:0 0 10px -2px #7B5CFF}
+.meter i.ok{background:var(--grad-live);box-shadow:0 0 10px -2px #19D3C5}
+.meter i.warn{background:var(--grad-warn);box-shadow:0 0 10px -2px #FF7A3D}
+.meter i.bad{background:var(--grad-hot);box-shadow:0 0 10px -2px #FF3B3B}
+
+/* ---------- alerts: glass with a glowing gradient edge ---------- */
+.alert{background:var(--surface);border:1px solid var(--glass-border);border-left:0;border-radius:var(--r);box-shadow:var(--shadow);padding-left:18px;
+  backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px)}
+.alert::before{content:"";position:absolute;left:0;top:10px;bottom:10px;width:3px;border-radius:0 3px 3px 0;background:var(--grad-unknown)}
+.alert.bad::before{background:var(--grad-hot);box-shadow:0 0 12px #FF3B3B}
+.alert.warn::before,.alert.data::before{background:var(--grad-warn);box-shadow:0 0 12px #FF7A3D}
+.alert.ok::before{background:var(--grad-live);box-shadow:0 0 12px #19D3C5}
+.alert.acc::before{background:var(--grad-brand);box-shadow:0 0 12px #7B5CFF}
+.alert.data{background:var(--surface)}
+.alert .tag{font-weight:600;border-radius:6px}
+.alert.bad .tag{background:var(--grad-hot);color:#fff}
+.alert.warn .tag,.alert.data .tag{background:var(--grad-warn);color:#2A1500}
+.alert.ok .tag{background:var(--grad-live);color:#062A22}
+.alert.acc .tag{background:var(--grad-brand);color:#fff}
+
+/* ---------- insight cards ---------- */
+.insight{background:var(--raised);border:1px solid var(--glass-border);border-left:0;border-radius:var(--r);padding-left:18px;box-shadow:var(--shadow)}
+.insight::before{content:"";position:absolute;left:0;top:12px;bottom:12px;width:3px;border-radius:0 3px 3px 0;background:var(--grad-unknown)}
+.insight.problem::before,.insight.threat::before{background:var(--grad-hot);box-shadow:0 0 12px #FF3B3B}
+.insight.opportunity::before{background:var(--grad-live);box-shadow:0 0 12px #19D3C5}
+.insight.insight-k::before{background:var(--grad-brand);box-shadow:0 0 12px #7B5CFF}
+.insight.unknown{background:var(--sunken);border-style:dashed}
+.insight .kind{font-family:var(--head);letter-spacing:.14em}
+.insight .acts button{border-radius:8px;transition:transform var(--d-mid) var(--ease-spring),background var(--d-mid),color var(--d-mid)}
+.insight .acts button:hover{transform:scale(1.06)}
+.insight .note{background:color-mix(in srgb,#7B5CFF 14%,transparent);border:1px solid var(--accent-line)}
+
+/* ---------- decisions ---------- */
+.decision{background:var(--surface);border:1px solid var(--accent-line);border-radius:var(--r);box-shadow:var(--shadow);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px)}
+.decision .num{width:30px;height:30px;border-radius:10px;display:grid;place-items:center;background:var(--grad-brand);color:#fff;font-weight:800;font-size:12px;box-shadow:var(--glow-brand)}
+
+/* ---------- goals, lists, tables, tabs ---------- */
+.goal{border-bottom-color:var(--line)}
+.goal .top .push{font-weight:700;color:var(--ink)}
+.list > .li{border-bottom-color:var(--line);transition:background var(--d-mid)}
+.list > button.li:hover{background:color-mix(in srgb,var(--ink) 4%,transparent)}
+table.t th{background:transparent;font-family:var(--head);letter-spacing:.12em;font-size:11px;color:var(--ink-2);border-bottom-color:var(--line)}
+table.t td{border-bottom-color:var(--line)}
+table.t td.n{font-weight:700;color:var(--ink)}
+table.t tbody tr{transition:background var(--d-mid)}
+table.t tbody tr:hover td{background:color-mix(in srgb,var(--ink) 4%,transparent)}
+.tabs{border-bottom-color:var(--line)}
+.tabs button{position:relative;border-bottom:0;transition:color var(--d-mid),transform var(--d-mid) var(--ease-spring)}
+.tabs button:hover{transform:scale(var(--zoom-text))}
+.tabs button::after{content:"";position:absolute;left:10px;right:10px;bottom:-1px;height:2px;border-radius:2px;background:var(--grad-brand);transform:scaleX(0);transition:transform var(--d-slow) var(--ease-spring);box-shadow:0 0 10px #7B5CFF}
+.tabs button[aria-selected="true"]::after{transform:scaleX(1)}
+
+/* ---------- section titles, empty and locked states ---------- */
+.sectitle h2{display:flex;align-items:center;gap:8px;color:var(--ink-2);font-weight:600;font-size:11.5px}
+.sectitle h2::before{content:"";width:6px;height:6px;border-radius:2px;background:var(--grad-brand);box-shadow:0 0 8px #7B5CFF}
+.empty{background:var(--sunken);border-color:var(--line-strong);border-radius:var(--r-lg)}
+.locked{background:linear-gradient(135deg,color-mix(in srgb,#FFB547 12%,transparent),color-mix(in srgb,#FF7A3D 5%,transparent));border-color:color-mix(in srgb,var(--warn) 45%,transparent);border-radius:var(--r)}
+.purpose{border-color:var(--glass-border);background:var(--line);border-radius:var(--r)}
+.purpose > div{background:var(--raised)}
+
+/* ---------- Overview specifics ---------- */
+.decisions{gap:10px}
+.opps{gap:var(--s4)}
+
+@media (prefers-reduced-motion:reduce){
+  .m-tilt,.m-tilt.m-hot{transform:none}
+  .tile:hover .v,.panel:hover > header h3,.insight:hover .h,.decision:hover .q,.goal:hover .top .h,.alert:hover .t,.tabs button:hover{transform:none}
+}
+
+/* =====================================================================
+   Step 3 — Company Brain, Maps, AI Workforce (+ Ask orchestration)
+   ===================================================================== */
+
+/* ---------- radial views: glass nodes, gradient arcs, glowing core ---------- */
+.radial .orbit{stroke:var(--line-strong);stroke-dasharray:1 6;stroke-linecap:round}
+.radial .spoke{stroke:var(--map-edge);stroke-width:1}
+.radial .spoke.hot{stroke:var(--accent);stroke-width:2;filter:drop-shadow(0 0 4px var(--accent))}
+.radial .spoke.flow{stroke:var(--ok);stroke-width:1.6;filter:drop-shadow(0 0 3px var(--ok))}
+.rnode .bg{fill:color-mix(in srgb,var(--solid) 88%,transparent);stroke:var(--glass-border);stroke-width:1.2;transition:stroke .25s,filter .3s,fill .25s}
+.rnode .track{stroke:var(--sunken);stroke-width:5}
+.rnode .arc{stroke:url(#m-grad-brand);stroke-width:5;filter:drop-shadow(0 0 4px rgba(123,92,255,.55))}
+.rnode .arc.low{stroke:url(#m-grad-warn);filter:drop-shadow(0 0 4px rgba(255,122,61,.5))}
+.rnode .lbl{font-family:var(--head);font-size:13.5px;font-weight:600;letter-spacing:.02em;transform-box:fill-box;transform-origin:center;transition:transform .25s var(--ease-spring)}
+.rnode .sub{font-family:var(--sans);font-weight:700;font-size:10.5px}
+.rnode:hover .bg,.rnode:focus-visible .bg{stroke:var(--accent);filter:drop-shadow(0 0 14px rgba(123,92,255,.55))}
+.rnode:hover .lbl{transform:scale(1.08)}
+.rnode.sel .bg{fill:color-mix(in srgb,#7B5CFF 22%,var(--solid));stroke:var(--accent);stroke-width:2;filter:drop-shadow(0 0 18px rgba(123,92,255,.7))}
+.rnode.dim{opacity:.35;transition:opacity .3s}
+.rnode .alarm{fill:url(#m-grad-hot);filter:drop-shadow(0 0 6px #FF3B3B);animation:alarm 1.8s ease-in-out infinite}
+@keyframes alarm{50%{opacity:.45}}
+/* the centre: a lit gradient orb with white text in both themes (fixes the dark-mode inversion) */
+.rcore .bg{fill:url(#m-grad-core);stroke:rgba(255,255,255,.18);stroke-width:1;filter:drop-shadow(0 0 28px rgba(123,92,255,.55))}
+.rcore:hover .bg{stroke:rgba(255,255,255,.35);filter:drop-shadow(0 0 36px rgba(123,92,255,.75))}
+.rcore .lbl{fill:#FFFFFF;font-family:var(--display);font-size:18px;letter-spacing:.1em}
+.rcore .sub{fill:rgba(255,255,255,.78);font-family:var(--sans);font-weight:700;font-size:11px}
+.rcore .ring{stroke:url(#m-grad-brand);stroke-width:2;opacity:.6;stroke-dasharray:3 7;stroke-linecap:round}
+.rcore .ring.build{animation:core-spin 26s linear infinite,breathe 3.2s ease-in-out infinite}
+@keyframes core-spin{to{transform:rotate(360deg)}}
+/* entrance: nodes fade and grow into place (inner shapes only, the node position is untouched) */
+.m-enter .rnode > *:not(.arc):not(.track){animation:node-in .7s var(--ease-spring) both;transform-box:fill-box;transform-origin:center}
+@keyframes node-in{from{opacity:0;transform:scale(.6)}}
+/* workforce: state rings */
+.rnode.agent .state{filter:drop-shadow(0 0 5px currentColor)}
+.rnode.agent.working .bg,.rnode.agent.analyzing .bg,.rnode.agent.researching .bg,.rnode.agent.executing .bg{stroke:var(--accent);animation:agent-glow 2s ease-in-out infinite}
+.rnode.agent.verifying .bg{stroke:var(--info);filter:drop-shadow(0 0 10px rgba(69,184,255,.5))}
+.rnode.agent.waiting .bg{stroke:var(--warn);filter:drop-shadow(0 0 8px rgba(255,181,71,.45))}
+.rnode.agent.completed .bg{stroke:var(--ok);filter:drop-shadow(0 0 8px rgba(46,230,168,.4))}
+.rnode.agent.planned .bg{stroke:var(--line-strong);fill:color-mix(in srgb,var(--solid) 55%,transparent)}
+@keyframes agent-glow{50%{filter:drop-shadow(0 0 14px rgba(123,92,255,.75))}}
+.radialwrap{filter:drop-shadow(0 20px 40px rgba(2,3,15,.25))}
+
+/* ---------- small rings reuse the gradients ---------- */
+.ringstat svg circle:nth-of-type(2){stroke:url(#m-grad-brand);filter:drop-shadow(0 0 5px rgba(123,92,255,.5))}
+.ringstat svg circle:nth-of-type(2)[stroke="var(--warn)"]{stroke:url(#m-grad-warn);filter:drop-shadow(0 0 5px rgba(255,122,61,.45))}
+
+/* ---------- flow maps ---------- */
+.mapwrap{background-color:var(--sunken);border:1px solid var(--glass-border);border-radius:var(--r-lg);
+  background-image:radial-gradient(color-mix(in srgb,var(--ink) 10%,transparent) 1px,transparent 1px);background-size:20px 20px;box-shadow:inset 0 1px 0 var(--glass-hi)}
+.map .coltitle{font-family:var(--head);letter-spacing:.18em;color:var(--ink-2);font-weight:600}
+.map svg.edges path{stroke:var(--map-edge);stroke-width:1.3}
+.map svg.edges path.hot{stroke:var(--accent);stroke-width:2;filter:drop-shadow(0 0 4px var(--accent))}
+.map svg.edges path.flow{stroke:var(--ok);filter:drop-shadow(0 0 3px var(--ok))}
+.map svg.edges path.broken{stroke:var(--bad);filter:drop-shadow(0 0 3px var(--bad))}
+.mnode{background:color-mix(in srgb,var(--solid) 90%,transparent);border:1px solid var(--glass-border);border-radius:12px;box-shadow:var(--shadow);
+  transition:transform .3s var(--ease-spring),border-color .25s,box-shadow .3s,opacity .3s,background .25s}
+.mnode:hover{transform:translateY(-2px) scale(1.04);border-color:var(--accent-line);box-shadow:var(--glow-brand);z-index:2}
+.mnode .h{font-weight:600}
+.mnode.sel{background:linear-gradient(135deg,color-mix(in srgb,#7B5CFF 30%,var(--solid)),color-mix(in srgb,#3D7BFF 16%,var(--solid)));border-color:var(--accent);box-shadow:var(--glow-brand);z-index:2}
+.mnode.core{background:var(--grad-brand);border-color:transparent;box-shadow:var(--glow-brand)}
+.mnode.core .h{color:#fff} .mnode.core .s{color:rgba(255,255,255,.78)}
+.mnode.gap{background:transparent;border-style:dashed;border-color:var(--line-strong);box-shadow:none}
+.mnode.bad{border-color:color-mix(in srgb,var(--bad) 60%,transparent);box-shadow:var(--glow-hot)}
+.m-enter .mnode{animation:m-pop .55s var(--ease-spring) both;animation-delay:calc(var(--mi,0) * 18ms + 150ms)}
+@keyframes m-pop{from{opacity:0;transform:scale(.85)}}
+
+/* ---------- agent states & agent cards ---------- */
+.agentstate{padding:2px 8px;border-radius:999px;background:color-mix(in srgb,var(--c) 12%,transparent);border:1px solid color-mix(in srgb,var(--c) 30%,transparent)}
+.agentstate::before{box-shadow:0 0 8px var(--c)}
+.agentcard .inp{border-bottom-color:var(--line)}
+
+/* ---------- Company Brain page ---------- */
+.conflict{background:linear-gradient(135deg,color-mix(in srgb,#FF4D8D 14%,transparent),color-mix(in srgb,#FF3B3B 5%,transparent));border:1px solid color-mix(in srgb,var(--bad) 45%,transparent);border-radius:var(--r-lg);box-shadow:var(--glow-hot);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px)}
+.conflict h4{font-family:var(--head);letter-spacing:.12em}
+.stackbar{height:9px;border-radius:5px;gap:2px;background:var(--sunken)}
+.stackbar i{border-radius:3px}
+.dom{background:var(--surface);border-color:var(--glass-border);border-radius:var(--r);transition:transform .3s var(--ease-spring),border-color .25s,box-shadow .3s}
+.dom:hover{transform:translateY(-2px);border-color:var(--accent-line);box-shadow:var(--glow-brand)}
+.dom .hbar i{background:var(--grad-brand)} .dom .hbar i.low{background:var(--grad-warn)}
+
+/* ---------- memory timeline (shared, used by the Brain) ---------- */
+.timeline::before{background:linear-gradient(180deg,var(--accent),color-mix(in srgb,var(--accent) 10%,transparent));width:2px;opacity:.6}
+.tl::before{background:var(--solid);border-color:var(--line-strong);transition:transform .25s var(--ease-spring)}
+.tl:hover::before{transform:scale(1.3)}
+.tl.tl-correction::before{background:var(--accent);border-color:var(--accent);box-shadow:0 0 10px var(--accent)}
+.tl.tl-result::before{background:var(--ok);border-color:var(--ok);box-shadow:0 0 10px var(--ok)}
+.tl.tl-change::before{border-color:var(--warn);box-shadow:0 0 8px color-mix(in srgb,var(--warn) 60%,transparent)}
+.tl.tl-fact::before{border-color:var(--info)}
+.tl .when{font-family:var(--sans);font-weight:600;font-size:11px}
+
+/* ---------- Ask: the orchestration console ---------- */
+.askbox{background:var(--surface);border:1px solid var(--glass-border);border-radius:var(--r-lg);box-shadow:var(--shadow);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);transition:box-shadow .3s,border-color .3s}
+.askbox:focus-within{border-color:var(--accent-line);box-shadow:var(--glow-brand)}
+.suggest button{background:var(--surface);border-color:var(--glass-border);transition:transform var(--d-mid) var(--ease-spring),border-color .2s,color .2s,box-shadow .2s}
+.suggest button:hover{transform:translateY(-1px) scale(var(--zoom-text));border-color:var(--accent-line);box-shadow:var(--glow-brand)}
+.suggest button[aria-pressed="true"]{background:linear-gradient(135deg,color-mix(in srgb,#7B5CFF 28%,transparent),color-mix(in srgb,#3D7BFF 14%,transparent));color:var(--ink)}
+.pstage{border-bottom-color:var(--line)}
+.pstage .ic{width:22px;height:22px;background:var(--sunken)}
+.pstage.done .ic{background:var(--grad-live);border-color:transparent;color:#062A22;box-shadow:var(--glow-live)}
+.pstage.run .ic{border-color:#7B5CFF;border-right-color:transparent;box-shadow:0 0 12px rgba(123,92,255,.6)}
+.pstage.stop .ic{background:var(--grad-hot);border-color:transparent;color:#fff;box-shadow:var(--glow-hot)}
+.pstage .n .stg{font-family:var(--head);font-size:11px;letter-spacing:.16em}
+.planrow{border-bottom-color:var(--line)}
+.planrow .k{font-family:var(--head);letter-spacing:.14em}
+.ev{border-bottom-color:var(--line)}
+.ev .id{font-weight:600}
+
+@media (prefers-reduced-motion:reduce){
+  .rcore .ring.build,.rnode .alarm,.rnode.agent.working .bg,.rnode.agent.analyzing .bg,.rnode.agent.researching .bg,.rnode.agent.executing .bg{animation:none}
+  .m-enter .rnode > *,.m-enter .mnode{animation:none}
+  .mnode:hover,.dom:hover,.suggest button:hover{transform:none}
+}
+/* narrow side panels (Brain node panel, etc.): stack key / value / source instead of squeezing three columns */
+.g2 > aside .kv .r,.g2.wide > aside .kv .r{grid-template-columns:minmax(0,1fr);gap:4px}
+.g2 > aside .kv .m,.g2.wide > aside .kv .m{justify-content:flex-start}
+.rnode.dim{opacity:.5}
+/* fact-row source labels share the .src name with data-source rows; keep them inline */
+.kv .m .src{display:inline;padding:0;border:0;font-size:11px}
+
+/* =====================================================================
+   STEP 4 — Company Information (profile overview, sections, vault,
+   follow-ups, validate & classify, agent context)
+   ===================================================================== */
+
+/* ---------- section stepper: glass chips, the current one glows ---------- */
+.cisteps{padding:4px 4px 12px;margin-left:-4px;margin-right:-4px}
+.cistep{border-radius:12px;border-color:var(--glass-border);background:var(--surface);box-shadow:var(--shadow);
+  backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);font-family:var(--head);font-size:12.5px;letter-spacing:.01em;
+  transition:transform var(--d-mid) var(--ease-spring),border-color var(--d-mid),box-shadow var(--d-mid),color var(--d-mid)}
+.cistep:hover{transform:translateY(-2px);border-color:var(--accent-line);color:var(--ink);box-shadow:var(--shadow-lift)}
+.cistep:active{transform:scale(var(--press))}
+.cistep[aria-current="step"]{border-color:transparent;color:var(--ink);font-weight:600;
+  background:linear-gradient(var(--solid),var(--solid)) padding-box,var(--grad-brand) border-box;border:1px solid transparent;box-shadow:var(--glow-brand)}
+.cistep .pct{font-family:var(--sans);font-weight:700;font-variant-numeric:tabular-nums;font-size:10.5px}
+.cistep .meter{height:5px}
+.m-enter .cistep{animation:ci-chip .5s var(--ease-spring) both;animation-delay:calc(var(--si,0) * 28ms + 120ms)}
+@keyframes ci-chip{from{opacity:0;transform:translateY(8px) scale(.96)}to{opacity:1;transform:none}}
+
+/* ---------- collect / why / how strip ---------- */
+.ciintro{background:var(--glass-border);border-color:var(--glass-border);border-radius:var(--r-lg);box-shadow:var(--shadow)}
+.ciintro > div{background:var(--surface);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);padding:13px 15px;transition:background var(--d-mid)}
+.ciintro > div:hover{background:color-mix(in srgb,var(--accent) 7%,var(--surface))}
+.ciintro .label{background:var(--grad-brand);-webkit-background-clip:text;background-clip:text;color:transparent}
+
+/* ---------- question rows ---------- */
+.cif{position:relative;transition:background var(--d-mid)}
+.cif::before{content:"";position:absolute;left:0;top:10px;bottom:10px;width:3px;border-radius:0 3px 3px 0;background:var(--grad-brand);
+  opacity:0;transform:scaleY(.4);transition:opacity var(--d-mid),transform var(--d-mid) var(--ease-spring)}
+.cif:hover{background:color-mix(in srgb,var(--ink) 3%,transparent)}
+.cif:focus-within{background:color-mix(in srgb,var(--accent) 6%,transparent)}
+.cif:focus-within::before{opacity:1;transform:none}
+.cif.pending{background:color-mix(in srgb,var(--info) 8%,transparent)}
+.cif.pending::before{opacity:1;transform:none;background:var(--grad-info);animation:ci-pulse 2.4s ease-in-out infinite}
+@keyframes ci-pulse{50%{opacity:.45}}
+.cif .q{font-family:var(--head);font-size:14.5px;font-weight:600;letter-spacing:.005em}
+.cif .q .opt{font-family:var(--sans);letter-spacing:0}
+.cif .meta .acts button{border-radius:999px;transition:background var(--d-mid),color var(--d-mid),transform var(--d-mid) var(--ease-spring)}
+.cif .meta .acts button:hover{background:var(--accent-soft);transform:translateY(-1px)}
+.cif .found{background:linear-gradient(var(--solid),var(--solid)) padding-box,var(--grad-info) border-box;border:1px solid transparent;
+  border-radius:12px;box-shadow:0 8px 24px -14px var(--info)}
+.cif .found b{background:var(--grad-info);-webkit-background-clip:text;background-clip:text;color:transparent}
+
+/* ---------- inputs: glass fields with a glowing focus ring ---------- */
+.input,.select,.textarea{background:color-mix(in srgb,var(--sunken) 70%,transparent);border-color:var(--glass-border);border-radius:10px;
+  transition:border-color var(--d-mid),box-shadow var(--d-mid),background var(--d-mid)}
+.input:hover,.select:hover,.textarea:hover{border-color:var(--line-strong)}
+.input:focus,.select:focus,.textarea:focus{outline:0;border-color:var(--accent);background:var(--sunken);
+  box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 22%,transparent),0 8px 24px -12px var(--accent)}
+.input::file-selector-button{margin-right:10px;padding:5px 12px;border:1px solid var(--glass-border);border-radius:8px;
+  background:var(--grad-brand);color:#fff;font:600 12.5px var(--sans);cursor:pointer;transition:filter var(--d-mid)}
+.input::file-selector-button:hover{filter:brightness(1.12)}
+
+/* ---------- "who are you?" choice cards ---------- */
+.cichoose button{position:relative;border-color:var(--glass-border);background:var(--surface);border-radius:var(--r-xl);
+  backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px)}
+.cichoose button:hover{border-color:var(--accent-line)}
+.cichoose button[aria-pressed="true"]{background:linear-gradient(color-mix(in srgb,var(--accent) 10%,var(--solid)),var(--solid)) padding-box,var(--grad-brand) border-box;
+  border:1px solid transparent;box-shadow:var(--glow-brand),var(--shadow-lift)}
+.cichoose button[aria-pressed="true"]::before{content:"";position:absolute;top:16px;right:16px;width:10px;height:10px;border-radius:50%;
+  background:var(--grad-live);box-shadow:var(--glow-live);animation:ci-pulse 2.4s ease-in-out infinite}
+.cichoose .t{font-family:var(--head);font-size:19px}
+.cihero{font-family:var(--head);font-weight:600;letter-spacing:0;
+  background:linear-gradient(90deg,var(--ink),color-mix(in srgb,var(--ink) 55%,var(--accent)));-webkit-background-clip:text;background-clip:text;color:transparent}
+
+/* ---------- profile overview: brain stats, flow chips ---------- */
+.cibrainstats .n{font-family:var(--sans);font-weight:800;font-size:26px;letter-spacing:-.01em}
+.cibrainstats > div + div{position:relative}
+.ciflow span.step{border-color:var(--glass-border);background:var(--surface);transition:border-color var(--d-mid),transform var(--d-mid) var(--ease-spring)}
+.ciflow span.step:hover{transform:translateY(-1px);border-color:var(--accent-line)}
+.ciflow span.step.hot{background:var(--grad-brand);border-color:transparent;color:#fff;box-shadow:var(--glow-brand)}
+
+/* ---------- follow-up conversation ---------- */
+.bubble{transition:transform var(--d-mid) var(--ease-spring)}
+.bubble.ai{background:var(--surface);border-color:var(--glass-border);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);box-shadow:var(--shadow)}
+.bubble.me{background:var(--grad-brand);color:#fff;box-shadow:0 1px 0 rgba(255,255,255,.22) inset,0 10px 26px -12px #5B6CFF}
+.bubble:hover{transform:translateY(-1px)}
+.m-enter .bubble{animation:ci-bub .5s var(--ease-spring) both;animation-delay:calc(var(--bi,0) * 60ms + 150ms)}
+.m-enter .bubble.me{animation-name:ci-bub-me}
+@keyframes ci-bub{from{opacity:0;transform:translateX(-10px) scale(.97)}to{opacity:1;transform:none}}
+@keyframes ci-bub-me{from{opacity:0;transform:translateX(10px) scale(.97)}to{opacity:1;transform:none}}
+.fuq{background:linear-gradient(var(--solid),var(--solid)) padding-box,var(--grad-brand) border-box;border:1px solid transparent;
+  border-radius:var(--r-xl);box-shadow:var(--glow-brand),var(--shadow-lift)}
+.fuq h2{font-family:var(--head);font-size:20px}
+
+/* ---------- agent context cards ---------- */
+.agentcard .inp{border-bottom-color:var(--line);border-radius:6px;transition:background var(--d-mid)}
+.agentcard .inp:hover{background:color-mix(in srgb,var(--ink) 4%,transparent)}
+
+@media (prefers-reduced-motion:reduce){
+  .cif.pending::before,.cichoose button[aria-pressed="true"]::before{animation:none}
+}
+
+/* =====================================================================
+   STEP 5 — Understand, Plan, Execute
+   ===================================================================== */
+
+/* ---------- fact tables: the source/actions column may not starve the value.
+   It is capped and wraps, so the value keeps a readable width (layout fix only) ---------- */
+.kv .r{grid-template-columns:minmax(120px,190px) minmax(180px,1fr) fit-content(46%)}
+.kv .r .m{row-gap:4px}
+.kv .r{transition:background var(--d-mid)}
+.kv .r:hover{background:color-mix(in srgb,var(--ink) 4%,transparent)}
+.kv .k{font-family:var(--head);font-size:13px;letter-spacing:.01em}
+
+/* ---------- domain header: health ring + status legend as a lit glass hero ---------- */
+.domhead{position:relative}
+.panel:has(> .domhead){background:linear-gradient(120deg,color-mix(in srgb,var(--accent) 12%,var(--surface)),var(--surface) 55%);overflow:hidden}
+.panel:has(> .domhead)::before{content:"";position:absolute;width:260px;height:260px;left:-80px;top:-120px;border-radius:50%;pointer-events:none;
+  background:radial-gradient(closest-side,color-mix(in srgb,var(--accent) 30%,transparent),transparent);filter:blur(10px);opacity:.7}
+.statusbar-legend .num{font-family:var(--sans);font-weight:700;color:var(--ink-2)}
+
+/* ---------- budget / mix bars: taller glowing segments ---------- */
+.stackbar{box-shadow:inset 0 1px 2px rgba(0,0,0,.25)}
+.stackbar i{position:relative;box-shadow:0 0 12px -2px currentColor;transition:filter var(--d-mid)}
+.stackbar i:hover{filter:brightness(1.2) saturate(1.1)}
+
+/* ---------- Execute: task board ---------- */
+.board{gap:var(--s4);padding-bottom:6px}
+.lane{position:relative;background:color-mix(in srgb,var(--sunken) 55%,transparent);border:1px solid var(--glass-border);
+  backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);padding:12px}
+.lane::before{content:"";position:absolute;left:14px;right:14px;top:0;height:2px;border-radius:0 0 2px 2px;background:var(--lane-grad,var(--grad-brand));
+  box-shadow:0 0 14px var(--lane-glow,#7B5CFF)}
+.board > .lane:nth-child(1){--lane-grad:var(--grad-info);--lane-glow:#3D9BFF}
+.board > .lane:nth-child(2){--lane-grad:var(--grad-brand);--lane-glow:#7B5CFF}
+.board > .lane:nth-child(3){--lane-grad:var(--grad-warn);--lane-glow:#FF9A3D}
+.board > .lane:nth-child(4){--lane-grad:var(--grad-live);--lane-glow:#2EE6A8}
+.lane > h3{font-family:var(--head);font-size:11.5px;font-weight:600;color:var(--ink-2)}
+.card{background:var(--surface);border-color:var(--glass-border);border-radius:14px;box-shadow:var(--shadow);padding:12px 13px;gap:8px}
+.card .h{font-family:var(--head);font-size:14.5px;font-weight:600;letter-spacing:.005em;line-height:1.3}
+.card.gate{border-color:transparent;background:linear-gradient(var(--solid),var(--solid)) padding-box,var(--grad-warn) border-box;border:1px solid transparent;
+  box-shadow:var(--glow-warn);animation:gate-breathe 3.2s ease-in-out infinite}
+@keyframes gate-breathe{50%{box-shadow:0 0 0 1px rgba(255,181,71,.2),0 6px 18px -8px rgba(255,122,61,.35)}}
+.card.gate.m-hot{animation:none}
+.m-enter .lane .card{animation:card-in .5s var(--ease-spring) both;animation-delay:calc(var(--ki,0) * 45ms + 180ms)}
+@keyframes card-in{from{opacity:0;transform:translateY(10px) scale(.97)}to{opacity:1;transform:none}}
+
+/* ---------- small headings inside content / creative panels ---------- */
+.cols .panel h3{font-family:var(--head);letter-spacing:.005em}
+
+@media (max-width:640px){
+  .kv .r{grid-template-columns:minmax(0,1fr)}
+  .kv .r .m{justify-content:flex-start}
+}
+@media (prefers-reduced-motion:reduce){ .card.gate{animation:none} }
+
+/* =====================================================================
+   STEP 6 — Learn & improve, Experiments, Evaluation
+   ===================================================================== */
+
+/* ---------- labelled statements (Fact / Observation / AI inference / Hypothesis) ---------- */
+.evstmt{border-radius:8px;padding:2px 6px;margin:0 -6px;transition:background var(--d-mid)}
+.evstmt:hover{background:color-mix(in srgb,var(--ink) 4%,transparent)}
+.evq{font-family:var(--head);font-weight:600;background:var(--grad-brand);-webkit-background-clip:text;background-clip:text;color:transparent}
+.evrow{transition:background var(--d-mid)}
+
+/* ---------- evidence → cause → impact chain: glass cells; labels keep their own width
+   (they were stretched into full-width bars by the grid cell — layout fix only) ---------- */
+.evchain{background:var(--glass-border);border-color:var(--glass-border);border-radius:12px}
+.evchain > div{background:var(--surface);justify-items:start;transition:background var(--d-mid)}
+.evchain > div:hover{background:color-mix(in srgb,var(--accent) 7%,var(--surface))}
+.evchain .label{background:var(--grad-brand);-webkit-background-clip:text;background-clip:text;color:transparent}
+.evask{background:color-mix(in srgb,var(--warn) 10%,var(--surface));border-radius:12px;box-shadow:0 8px 22px -16px var(--warn)}
+
+/* ---------- the headline tile of an evaluation ---------- */
+.tile.evmain{border-color:transparent;background:linear-gradient(color-mix(in srgb,var(--accent) 12%,var(--solid)),var(--solid)) padding-box,var(--grad-brand) border-box;
+  border:1px solid transparent;box-shadow:var(--glow-brand),var(--shadow-lift)}
+
+/* ---------- retention chart: glowing lines that draw in (motion.js) ---------- */
+svg[aria-label^="Viewer retention"] path{filter:drop-shadow(0 0 5px color-mix(in srgb,var(--accent) 70%,transparent));stroke-linecap:round;stroke-linejoin:round}
+svg[aria-label^="Viewer retention"] circle{filter:drop-shadow(0 0 4px var(--accent))}
+
+/* ---------- recommendations: the tag reads as a gradient badge ---------- */
+.alert.acc > .tag{background:var(--grad-brand);color:#fff;border-color:transparent;box-shadow:0 4px 14px -6px #7B5CFF}
+.alert.bad > .tag{background:var(--grad-hot);color:#fff;border-color:transparent;box-shadow:0 4px 14px -6px #FF3B3B}
+
+/* ---------- "what else changed in this window" ---------- */
+.locked .t{font-family:var(--head);font-weight:600;letter-spacing:.01em}
+
+/* =====================================================================
+   STEP 7 — overlays (drawer, modal, toast, scrim), onboarding, Website view
+   ===================================================================== */
+
+/* ---------- overlays ---------- */
+.scrim{backdrop-filter:blur(6px) saturate(120%);-webkit-backdrop-filter:blur(6px) saturate(120%);transition:opacity .28s ease}
+.drawer{border-left:1px solid var(--glass-border);box-shadow:-30px 0 80px -20px rgba(2,3,15,.7),var(--shadow-lift);
+  transition:transform .46s var(--ease-spring)}
+.drawer::before{content:"";position:absolute;left:-1px;top:0;bottom:0;width:2px;background:var(--grad-brand);box-shadow:0 0 18px #7B5CFF;opacity:.85}
+.drawer > header{position:relative;border-bottom-color:var(--line)}
+.drawer > header::after{content:"";position:absolute;left:18px;right:18px;bottom:-1px;height:1px;background:linear-gradient(90deg,var(--accent),transparent)}
+.drawer > header h2,.modal > header h2{font-family:var(--head);font-weight:600;letter-spacing:.01em}
+.drawer.on .body > *{animation:ov-in .45s var(--ease-spring) both}
+.drawer.on .body > :nth-child(2){animation-delay:.05s} .drawer.on .body > :nth-child(3){animation-delay:.1s}
+.drawer.on .body > :nth-child(4){animation-delay:.15s} .drawer.on .body > :nth-child(n+5){animation-delay:.2s}
+@keyframes ov-in{from{opacity:0;transform:translateX(14px)}to{opacity:1;transform:none}}
+.modal{background:linear-gradient(var(--solid),var(--solid)) padding-box,linear-gradient(135deg,color-mix(in srgb,var(--accent) 70%,transparent),var(--glass-border) 45%,var(--glass-border)) border-box;
+  border:1px solid transparent;border-radius:var(--r-xl);box-shadow:var(--glow-brand),var(--shadow-lift);
+  transform:translate(-50%,-46%) scale(.96);transition:opacity .22s ease,transform .38s var(--ease-spring)}
+.modal.on{transform:translate(-50%,-50%) scale(1)}
+.toast{background:var(--solid);color:var(--ink);border:1px solid var(--glass-border);border-radius:14px;padding:11px 16px 11px 20px;
+  box-shadow:var(--glow-brand),var(--shadow-lift);transition:opacity .25s ease,transform .4s var(--ease-spring);overflow:hidden}
+.toast::before{content:"";position:absolute;left:0;top:8px;bottom:8px;width:3px;border-radius:0 3px 3px 0;background:var(--grad-brand);box-shadow:0 0 10px #7B5CFF}
+
+/* ---------- onboarding ---------- */
+.onb{background:transparent}
+.onbtop{background:color-mix(in srgb,var(--surface) 80%,transparent);border-bottom-color:var(--glass-border);
+  backdrop-filter:blur(var(--blur)) saturate(140%);-webkit-backdrop-filter:blur(var(--blur)) saturate(140%)}
+.onbtop .brand b{background:linear-gradient(90deg,var(--ink),color-mix(in srgb,var(--ink) 60%,var(--accent)));-webkit-background-clip:text;background-clip:text;color:transparent}
+.phase{font-family:var(--head);font-weight:600;transition:color var(--d-mid)}
+.phase i{font-family:var(--sans);font-weight:700;transition:background var(--d-mid),box-shadow var(--d-mid)}
+.phase.on i{background:var(--grad-brand);border-color:transparent;color:#fff;box-shadow:0 0 0 4px color-mix(in srgb,var(--accent) 20%,transparent),0 0 16px #7B5CFF;animation:ci-pulse 2.4s ease-in-out infinite}
+.phase.done i{background:var(--grad-live);border-color:transparent;color:#04121A;box-shadow:0 0 12px #19D3C5}
+.phase-sep{border-radius:1px}
+.phase.done + .phase-sep{background:var(--grad-live)}
+.onbmain h1{font-family:var(--head);font-weight:600;letter-spacing:.005em}
+.onbq h2{font-family:var(--head);font-size:21px}
+.onbq .qn{font-family:var(--sans);font-weight:700;letter-spacing:.04em;background:var(--grad-brand);-webkit-background-clip:text;background-clip:text;color:transparent}
+.onbside{background:color-mix(in srgb,var(--surface) 85%,transparent);border-left-color:var(--glass-border);
+  backdrop-filter:blur(var(--blur));-webkit-backdrop-filter:blur(var(--blur))}
+
+/* ---------- Website view ---------- */
+.hero h1 em{background:var(--grad-brand);-webkit-background-clip:text;background-clip:text;color:transparent;
+  filter:drop-shadow(0 0 22px color-mix(in srgb,var(--accent) 45%,transparent))}
+.flownode,.answer,.layer,.agent,.tier{border-color:var(--glass-border);background:var(--surface);box-shadow:var(--shadow);
+  backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px)}
+.flownode h4,.answer h4,.layer h3,.tier h4,.agent h4{font-family:var(--head);font-weight:600}
+.flownode.brainnode,.answer.bios,.tier.feat{border-color:transparent;border:1px solid transparent;
+  background:linear-gradient(color-mix(in srgb,var(--accent) 12%,var(--solid)),var(--solid)) padding-box,var(--grad-brand) border-box;
+  box-shadow:var(--glow-brand),var(--shadow-lift)}
+.flownode.brainnode{animation:gate-breathe-brand 3.6s ease-in-out infinite}
+@keyframes gate-breathe-brand{50%{box-shadow:0 0 0 1px rgba(139,108,255,.2),0 6px 20px -8px rgba(123,92,255,.35)}}
+.flownode.brainnode.m-hot{animation:none}
+.flownode.brainnode h4{background:var(--grad-brand);-webkit-background-clip:text;background-clip:text;color:transparent}
+.answer.generic{background:color-mix(in srgb,var(--sunken) 70%,transparent)}
+.layer::before{background:var(--grad-brand);color:#fff;border-color:transparent;font-family:var(--sans);font-weight:700;box-shadow:0 0 14px -2px #7B5CFF}
+.agent .role{background:var(--grad-brand);-webkit-background-clip:text;background-clip:text;color:transparent;font-weight:600}
+.tier li::before{color:var(--accent)}
+/* sections below the fold rise in as they scroll into view (motion.js adds/removes these classes) */
+.m-reveal{opacity:0;transform:translateY(22px)}
+.m-reveal.m-in{opacity:1;transform:none;transition:opacity .7s var(--ease-out),transform .8s var(--ease-spring);transition-delay:calc(var(--ri,0) * 70ms)}
+
+@media (prefers-reduced-motion:reduce){
+  .phase.on i,.flownode.brainnode{animation:none}
+  .drawer.on .body > *{animation:none}
+  .m-reveal{opacity:1;transform:none}
+}
